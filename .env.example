# ==============================================================================
# SKALEATHON 2027 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Skaleathon 2027"

# Supabase (PostgreSQL Database & Storage)
# Required for production database persistence and signed storage uploads.
# For local evaluation, an automated fallback in-memory/JSON or direct SQL is supported.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# Authentication (Clerk)
# When set, the system uses Clerk's enterprise authentication.
# In development mode without Clerk keys, our secure built-in role provider activates.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Explicitly opt in to the local-only development login endpoint. Never enable in production.
ENABLE_DEV_LOGIN=false

# Payment Gateway (Razorpay)
# Registration fee: ₹99 per team.
# Keys are obtained from the Razorpay Dashboard (Settings -> API Keys).
# Never commit real keys. In sandbox mode, test signatures and orders work cleanly.
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
# Local tests only. Production ignores this flag and always requires real signatures.
ENABLE_PAYMENT_SANDBOX=false

# Admin Configuration & Allowlist
# Comma-separated list of email addresses granted initial Administrator privileges
ADMIN_EMAILS=skalekraft@gmail.com,organizer@skaleathon.in

# Email & Notifications (Resend / SMTP / Console Dev Fallback)
# When EMAIL_SERVER / RESEND_API_KEY is not configured, logs to console in dev mode
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM=Skaleathon 2027 <no-reply@skaleathon.in>

# Application Security
# Secret used for signing internal verification tokens and session validation
APP_SECRET=replace_with_a_secure_random_64_char_hex_string_in_production
